{
  "schema_version": 6,
  "database": "SQLite",
  "tables": [
    {
      "name": "users",
      "columns": [
        {
          "name": "id",
          "type": "TEXT",
          "primary_key": true
        },
        {
          "name": "username",
          "type": "TEXT",
          "not_null": true,
          "unique": true
        },
        {
          "name": "display_name",
          "type": "TEXT",
          "not_null": true
        },
        {
          "name": "password_hash",
          "type": "TEXT",
          "not_null": true
        },
        {
          "name": "created_at",
          "type": "TEXT",
          "not_null": true
        }
      ]
    },
    {
      "name": "sessions",
      "columns": [
        {
          "name": "token_hash",
          "type": "TEXT",
          "primary_key": true
        },
        {
          "name": "user_id",
          "type": "TEXT",
          "not_null": true,
          "references": "users.id",
          "on_delete": "CASCADE"
        },
        {
          "name": "expires_at",
          "type": "TEXT",
          "not_null": true
        }
      ]
    },
    {
      "name": "boards",
      "columns": [
        {
          "name": "id",
          "type": "TEXT",
          "primary_key": true
        },
        {
          "name": "user_id",
          "type": "TEXT",
          "not_null": true,
          "references": "users.id",
          "on_delete": "CASCADE"
        },
        {
          "name": "name",
          "type": "TEXT",
          "not_null": true
        },
        {
          "name": "created_at",
          "type": "TEXT",
          "not_null": true
        },
        {
          "name": "updated_at",
          "type": "TEXT",
          "not_null": true
        }
      ],
      "indexes": [
        [
          "user_id"
        ]
      ]
    },
    {
      "name": "board_columns",
      "columns": [
        {
          "name": "board_id",
          "type": "TEXT",
          "not_null": true,
          "references": "boards.id",
          "on_delete": "CASCADE"
        },
        {
          "name": "id",
          "type": "TEXT",
          "not_null": true
        },
        {
          "name": "title",
          "type": "TEXT",
          "not_null": true
        },
        {
          "name": "wip_limit",
          "type": "INTEGER",
          "check": "1-99"
        },
        {
          "name": "position",
          "type": "INTEGER",
          "not_null": true
        }
      ],
      "primary_key": [
        "board_id",
        "id"
      ],
      "unique": [
        [
          "board_id",
          "position"
        ]
      ]
    },
    {
      "name": "cards",
      "columns": [
        {
          "name": "board_id",
          "type": "TEXT",
          "not_null": true
        },
        {
          "name": "id",
          "type": "TEXT",
          "not_null": true
        },
        {
          "name": "column_id",
          "type": "TEXT",
          "not_null": true
        },
        {
          "name": "title",
          "type": "TEXT",
          "not_null": true
        },
        {
          "name": "details",
          "type": "TEXT",
          "not_null": true
        },
        {
          "name": "priority",
          "type": "TEXT",
          "check": "low | medium | high"
        },
        {
          "name": "due_date",
          "type": "TEXT",
          "format": "YYYY-MM-DD"
        },
        {
          "name": "labels",
          "type": "TEXT",
          "not_null": true,
          "default": "[]",
          "format": "JSON array of strings"
        },
        {
          "name": "checklist",
          "type": "TEXT",
          "not_null": true,
          "default": "[]",
          "format": "JSON array of {id, text, done} objects"
        },
        {
          "name": "archived",
          "type": "INTEGER",
          "not_null": true,
          "default": "0",
          "format": "0 or 1"
        },
        {
          "name": "position",
          "type": "INTEGER",
          "not_null": true
        }
      ],
      "primary_key": [
        "board_id",
        "id"
      ],
      "foreign_keys": [
        {
          "columns": [
            "board_id",
            "column_id"
          ],
          "references": "board_columns(board_id, id)",
          "on_delete": "CASCADE"
        }
      ],
      "unique": [
        [
          "board_id",
          "column_id",
          "position"
        ]
      ]
    },
    {
      "name": "activity",
      "columns": [
        {
          "name": "id",
          "type": "INTEGER",
          "primary_key": true,
          "autoincrement": true
        },
        {
          "name": "board_id",
          "type": "TEXT",
          "not_null": true,
          "references": "boards.id",
          "on_delete": "CASCADE"
        },
        {
          "name": "source",
          "type": "TEXT",
          "not_null": true,
          "check": "user | assistant"
        },
        {
          "name": "message",
          "type": "TEXT",
          "not_null": true
        },
        {
          "name": "created_at",
          "type": "TEXT",
          "not_null": true
        }
      ],
      "indexes": [
        [
          "board_id",
          "id"
        ]
      ]
    }
  ]
}
